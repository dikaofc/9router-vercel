[TEMPLATE]
# 9Router environment contract

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Vercel KV persistence (for data to survive cold starts)
# Get these from: https://vercel.com/docs/storage/vercel-kv
# KV_REST_API_URL=https://<region>.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxxxxxxx

# Upstash Redis alternative (works with Vercel too)
# UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Cloud sync variables
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# API Keys for Vercel (comma-separated)
# These are re-seeded on every cold start
# API_KEYS=sk-xxxxxxxx,sk-yyyyyyyy

# Provider API Keys — DO NOT set here for Vercel. Add them in the DASHBOARD
# (Settings → Providers); on Vercel they persist to Upstash and are shared
# across serverless instances. Vercel-env provider keys are no longer auto-seeded.
# PROVIDER_GROQ_API_KEY=gsk_xxxxx
# PROVIDER_GEMINI_API_KEY=AIzaSy...
# PROVIDER_DEEPSEEK_API_KEY=sk-...
# PROVIDER_SILICONFLOW_API_KEY=sk-...
# PROVIDER_OPENAI_API_KEY=sk-...  (optional, expensive)

# Proxy variables (optional)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
