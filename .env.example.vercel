# ============================================================
# 9Router — Vercel Environment Variables
# ============================================================
# Copy this to your Vercel project's Environment Variables
# Settings → Environment Variables → Add
#
# REQUIRED:
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
INITIAL_PASSWORD=change-me-to-a-secure-password

# ─── PERSISTENCE (so config/usage survive cold starts & are shared across instances) ───
# PRIMARY: Upstash Redis (free tier works). Get URL+token at https://upstash.com
# Without this, 9Router falls back to Supabase (if configured) → KV → in-memory (data lost on cold start).
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# FALLBACK: Supabase Storage (optional). Set if you prefer Supabase over Upstash.
# DIKA_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_DIKA_SUPABASE_URL=https://your-project.supabase.co

# RECOMMENDED — API key for CLI tools to authenticate with your 9Router:
API_KEY_SECRET=your-secret-api-key-here

# PROVIDER API KEYS — add the ones you want to use:
# Each creates an auto-configured connection on cold start.
# Expensive/oauth-subscription providers are DISABLED by default (seeded to
# disabledModels) — enable them manually in the dashboard if you have a plan.
#
# Free / cheap providers (add API key if required):
# PROVIDER_OPENCODE_GO_API_KEY=your-opencode-go-key
# PROVIDER_GEMINI_API_KEY=your-google-key
# PROVIDER_GEMINI_CLI_API_KEY=your-gemini-cli-key
# PROVIDER_GLM_API_KEY=your-zhipu-key
# PROVIDER_DEEPSEEK_API_KEY=your-deepseek-key
# PROVIDER_GROQ_API_KEY=your-groq-key
# PROVIDER_NVIDIA_API_KEY=your-nvidia-key
# PROVIDER_CLOUDFLARE_AI_API_KEY=your-cf-key
#
# Or use a generic provider:
# PROVIDER_NAME=openai
# PROVIDER_API_KEY=sk-xxxx

# OPTIONAL:
# RECOMMENDED for security:
# REQUIRE_API_KEY=true

# CORS (for browser-based tools):
# NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app

