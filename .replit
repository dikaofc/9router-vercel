run = "npm run build:low-mem && npm run start:replit"

entrypoint = "custom-server.js"

[nix]
channel = "stable-24_05"

[env]
HOSTNAME = "0.0.0.0"
NODE_ENV = "production"
NEXT_TELEMETRY_DISABLED = "1"
DATA_DIR = "/tmp/.9router"
USE_SQLJS = "1"
NODE_OPTIONS = "--max-old-space-size=384"
NEXT_WORKER_COUNT = "1"

[languages.javascript]
pattern = "**/*.js"

[deployment]
run = ["sh", "-c", "npm install && npm run build:low-mem && npm run start:replit"]
build = ["sh", "-c", "npm install"]
